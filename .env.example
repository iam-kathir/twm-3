# =========================================================================
# TWM 3.1 — Environment Configuration Template
# Copy this file to .env.local for local development.
# Do NOT commit .env or .env.local with real secrets.
# =========================================================================

# -------------------------------------------------------------------------
# 1. GitHub OAuth App (§6.1, §17.4)
# Create a GitHub OAuth App at: https://github.com/settings/developers
# - Application name: Track. Win. Maintain (TWM)
# - Homepage URL: http://localhost:3000 (or your production domain)
# - Authorization callback URL: http://localhost:3000/api/auth/github/callback
# -------------------------------------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# -------------------------------------------------------------------------
# 2. Tamper-Proof Session Signing (§17.4)
# Generate a cryptographically secure 64-character hex secret:
# In Node.js / PowerShell: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# -------------------------------------------------------------------------
TWM_SESSION_SECRET=

# -------------------------------------------------------------------------
# 3. Institutional College Email Domains (§6.1)
# Comma-separated list of approved institutional domains for pilot cohorts.
# Rejects arbitrary commercial/personal email addresses.
# -------------------------------------------------------------------------
COLLEGE_EMAIL_DOMAINS=karunya.edu,vitstudent.ac.in,srmist.edu.in,nitt.edu,iitm.ac.in

# -------------------------------------------------------------------------
# 4. Transactional Email Provider (Resend / SendGrid)
# Mandatory for live OTP delivery. In development without keys, the system
# falls back safely with informative alerts; in production, missing config
# fails closed with 502/configuration error.
# Resend (Recommended): https://resend.com/api-keys
# -------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=TWM Verification <verify@twm.yourdomain.com>

# SendGrid (Alternative Provider): https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# -------------------------------------------------------------------------
# 5. Cron & Admin Boundary Finalization Secret (§9.1, §9.7)
# Used to authenticate automated Sunday 23:59:59 IST finalization sweeps.
# Header: Authorization: Bearer <CRON_SECRET>
# -------------------------------------------------------------------------
CRON_SECRET=
ADMIN_TOKEN=

# -------------------------------------------------------------------------
# 6. Base URL (Optional, defaults to request origin)
# -------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

